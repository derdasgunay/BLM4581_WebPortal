@model IEnumerable<WebPortal.Models.Event>

<div class="ep-hero">
    <div class="container">
        <h1 class="fw-bold mb-2">Etkinlikler</h1>
        <p>Katılmak istediğin etkinliği bul, detaylarını incele.</p>
    </div>
</div>

<div class="container">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <span class="ep-soluk">@Model.Count() etkinlik listeleniyor</span>
        <a asp-action="Create" class="btn btn-turuncu">+ Yeni Etkinlik</a>
    </div>

    <div class="row g-4">
        @foreach (var etkinlik in Model)
        {
            var kayitli = etkinlik.Registrations.Count;
            var yuzde = etkinlik.Capacity > 0 ? kayitli * 100 / etkinlik.Capacity : 0;

            <div class="col-md-6 col-lg-4">
                <div class="ep-card d-flex flex-column gap-2">
                    <span class="ep-badge align-self-start">@etkinlik.Category?.Name</span>
                    <h3 class="h5 fw-bold mb-0">@etkinlik.Title</h3>
                    <span class="ep-tarih">@etkinlik.Date.ToString("dd.MM.yyyy HH:mm")</span>
                    <p class="ep-soluk flex-grow-1 mb-2">@etkinlik.Description</p>

                    <div class="progress ep-progress">
                        <div class="progress-bar" style="width: @yuzde%"></div>
                    </div>
                    <small class="ep-soluk">@kayitli / @etkinlik.Capacity kayıtlı</small>

                    <div class="d-flex gap-2 mt-2">
                        <a asp-action="Details" asp-route-id="@etkinlik.Id" class="btn btn-lacivert btn-sm">Detay</a>
                        <a asp-action="Edit" asp-route-id="@etkinlik.Id" class="btn btn-outline-secondary btn-sm">Düzenle</a>
                        <a asp-action="Delete" asp-route-id="@etkinlik.Id" class="btn btn-outline-danger btn-sm">Sil</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>