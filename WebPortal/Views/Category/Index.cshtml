@model IEnumerable<WebPortal.Models.Category>
@{
    ViewData["Title"] = "Kategoriler";
}

<div class="ep-hero">
    <div class="container">
        <h1 class="fw-bold mb-2">Kategoriler</h1>
        <p>Etkinlik kategorilerini yönet.</p>
    </div>
</div>

<div class="container">
    <div class="d-flex justify-content-end mb-3">
        <a asp-controller="Category" asp-action="Create" class="btn btn-turuncu">+ Yeni Kategori</a>
    </div>

    <div class="ep-card">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Kategori Adı</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td class="fw-semibold">@item.Name</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-turuncu">Düzenle</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" onclick="return confirm('Bu kategoriyi silmek istediğinize emin misiniz?')">Sil</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>