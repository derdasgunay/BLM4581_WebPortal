@model IEnumerable<WebPortal.Models.Category>
@{
    ViewData["Title"] = "Kategoriler";
}

<h1>Kategoriler</h1>
<a asp-controller="Category" asp-action="Create" class="btn btn-primary mb-3">Yeni Kategori</a>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Kategori Adı</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Düzenle</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" onclick="return confirm('Bu kategoriyi silmek istediğinize emin misiniz?')">Sil</a>
                </td>
            </tr>
        }
    </tbody>
</table>